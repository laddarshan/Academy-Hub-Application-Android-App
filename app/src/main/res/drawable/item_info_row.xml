<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="false"
    android:focusable="false">

    <!-- Icon box -->
    <FrameLayout
        android:id="@+id/irIconBox"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_menu_icon_green"
        android:layout_marginEnd="14dp">
        <ImageView
            android:id="@+id/irIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"
            app:tint="#059669"/>
    </FrameLayout>

    <!-- Text -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/irLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Label"
            android:textColor="?attr/colorTextMuted"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true"
            android:letterSpacing="0.04"/>
        <TextView
            android:id="@+id/irValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Value"
            android:textColor="?attr/colorText1"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="1dp"/>
    </LinearLayout>

    <!-- Divider at bottom (drawn via background, so add via code or use cardview divider) -->
</LinearLayout>
