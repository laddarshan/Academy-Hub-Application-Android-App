<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/primary_color"
        android:paddingStart="4dp" android:paddingEnd="16dp"
        android:paddingTop="32dp" android:paddingBottom="12dp"
        android:elevation="6dp">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_back" android:padding="12dp"
            android:contentDescription="Back"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"/>
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="4dp">
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Fees Structure"
                android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvGroupBadge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=""
                android:textColor="#AAFFEE" android:textSize="11sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <!-- Delete button (shown only when existing structure) -->
        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_delete" android:padding="10dp"
            android:contentDescription="Delete"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            app:tint="#FFCDD2"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary_color"
        android:visibility="gone"/>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="20dp" android:paddingBottom="32dp">

            <!-- Existing structure card (hidden until loaded) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCurrentStructure"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardCornerRadius="14dp" app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <View android:layout_width="3dp" android:layout_height="16dp"
                            android:background="@drawable/bg_timetable_left_bar"
                            android:layout_marginEnd="8dp"/>
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Current Structure"
                            android:textSize="13sp" android:textStyle="bold"
                            android:textColor="@color/primary_color"/>
                    </LinearLayout>

                    <!-- Stats row -->
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvCurrentTotal"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="₹0"
                                android:textSize="20sp" android:textStyle="bold"
                                android:textColor="@color/primary_color"/>
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Total Fees"
                                android:textSize="11sp" android:textColor="?attr/colorControlNormal"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="40dp"
                            android:background="?attr/colorControlHighlight"/>

                        <LinearLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvCurrentInstallments"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="20sp" android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Installments"
                                android:textSize="11sp" android:textColor="?attr/colorControlNormal"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="40dp"
                            android:background="?attr/colorControlHighlight"/>

                        <LinearLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvCurrentInstAmt"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="₹0"
                                android:textSize="18sp" android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Per Installment"
                                android:textSize="11sp" android:textColor="?attr/colorControlNormal"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Description -->
                    <TextView
                        android:id="@+id/tvCurrentDescription"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp" android:textColor="?attr/colorControlNormal"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section label -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <View android:layout_width="3dp" android:layout_height="16dp"
                    android:background="@drawable/bg_timetable_left_bar"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:id="@+id/tvFormTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Set Fees Structure"
                    android:textSize="13sp" android:textStyle="bold"
                    android:textColor="@color/primary_color"/>
            </LinearLayout>

            <!-- Input card -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_section_card"
                android:layout_marginBottom="16dp" android:elevation="1dp">

                <!-- Total Fees -->
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:layout_gravity="center" android:src="@drawable/ic_fees"
                            android:contentDescription="Fees"
                            app:tint="#FFFFFF"/>
                    </FrameLayout>
                    <EditText
                        android:id="@+id/etTotalFees"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Total Fees (₹) *"
                        android:textSize="14sp" android:textColor="?attr/colorOnSurface"
                        android:inputType="numberDecimal" android:maxLines="1"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="60dp"
                    android:background="?attr/colorControlHighlight"/>

                <!-- Installments -->
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:layout_gravity="center" android:src="@drawable/ic_academic"
                            android:contentDescription="Installments"
                            app:tint="#FFFFFF"/>
                    </FrameLayout>
                    <EditText
                        android:id="@+id/etInstallments"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Number of Installments *"
                        android:textSize="14sp" android:textColor="?attr/colorOnSurface"
                        android:inputType="number" android:maxLines="1"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="60dp"
                    android:background="?attr/colorControlHighlight"/>

                <!-- Auto-calculated -->
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_count_badge">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:layout_gravity="center" android:src="@drawable/ic_result"
                            android:contentDescription="Calc"
                            app:tint="@color/primary_color"/>
                    </FrameLayout>
                    <TextView
                        android:id="@+id/tvCalculated"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text=""
                        android:textSize="13sp" android:textStyle="bold"
                        android:textColor="@color/primary_color"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="60dp"
                    android:background="?attr/colorControlHighlight"/>

                <!-- Description / Notes -->
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="top"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:layout_gravity="center" android:src="@drawable/ic_announcement"
                            android:contentDescription="Notes"
                            app:tint="#FFFFFF"/>
                    </FrameLayout>
                    <EditText
                        android:id="@+id/etDescription"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Notes / Description (optional)"
                        android:textSize="14sp" android:textColor="?attr/colorOnSurface"
                        android:inputType="textMultiLine"
                        android:minLines="2" android:maxLines="4"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Save Button -->
            <LinearLayout
                android:id="@+id/btnSave"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:gravity="center"
                android:background="@drawable/bg_upload_btn"
                android:clickable="true" android:focusable="true">
                <ImageView
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_fees" android:contentDescription="Save"
                    android:layout_marginEnd="10dp" app:tint="#FFFFFF"/>
                <TextView
                    android:id="@+id/tvSaveLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Save Fees Structure"
                    android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
