<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/primary_color"
        android:paddingStart="4dp" android:paddingEnd="16dp"
        android:paddingTop="32dp" android:paddingBottom="12dp" android:elevation="4dp">
        <ImageView android:id="@+id/btnBack"
            android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_back" android:padding="12dp"
            android:contentDescription="Back" android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
            <TextView android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="New Announcement"
                android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Fill in details and send"
                android:textColor="#AAFFEE" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <ImageView android:layout_width="26dp" android:layout_height="26dp"
            android:src="@drawable/ic_send_notif" android:contentDescription="Send"
            app:tint="#AAFFEE"/>
    </LinearLayout>

    <!-- Progress indicator -->
    <ProgressBar android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp"
        android:indeterminate="true" android:indeterminateTint="@color/primary_color"
        android:visibility="gone"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="20dp" android:paddingBottom="32dp">

            <!-- Section label -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <View android:layout_width="3dp" android:layout_height="16dp"
                    android:background="@drawable/bg_timetable_left_bar" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ANNOUNCEMENT DETAILS"
                    android:textSize="11sp" android:textStyle="bold"
                    android:textColor="@color/primary_color" android:letterSpacing="0.08"/>
            </LinearLayout>

            <!-- Title + Message Card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_section_card"
                android:layout_marginBottom="14dp" android:elevation="1dp">

                <!-- Title row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:layout_gravity="center" android:src="@drawable/ic_announcement"
                            android:contentDescription="Title" app:tint="#FFFFFF"/>
                    </FrameLayout>
                    <EditText android:id="@+id/etTitle"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Announcement title *"
                        android:textSize="14sp" android:textColor="?attr/colorOnSurface"
                        android:inputType="textCapSentences" android:maxLines="1"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="58dp" android:background="?attr/colorControlHighlight"/>

                <!-- Message row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="top"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingTop="12dp" android:paddingBottom="12dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:layout_gravity="center" android:src="@drawable/ic_email"
                            android:contentDescription="Message" app:tint="#FFFFFF"/>
                    </FrameLayout>
                    <EditText android:id="@+id/etMessage"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Message content *"
                        android:textSize="14sp" android:textColor="?attr/colorOnSurface"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="4" android:maxLines="8" android:gravity="top"/>
                </LinearLayout>
            </LinearLayout>

            <!-- PRIORITY -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <View android:layout_width="3dp" android:layout_height="16dp"
                    android:background="@drawable/bg_timetable_left_bar" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PRIORITY"
                    android:textSize="11sp" android:textStyle="bold"
                    android:textColor="@color/primary_color" android:letterSpacing="0.08"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="16dp">
                <LinearLayout android:id="@+id/btnNormal"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:orientation="horizontal" android:gravity="center"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_day_chip_active"
                    android:clickable="true" android:focusable="true">
                    <View android:layout_width="8dp" android:layout_height="8dp"
                        android:background="@drawable/bg_dot_active" android:layout_marginEnd="6dp"/>
                    <TextView android:id="@+id/tvNormalLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Normal" android:textColor="#FFFFFF"
                        android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/btnImportant"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:orientation="horizontal" android:gravity="center"
                    android:background="@drawable/bg_day_chip_inactive"
                    android:clickable="true" android:focusable="true">
                    <View android:id="@+id/dotImportant"
                        android:layout_width="8dp" android:layout_height="8dp"
                        android:background="@drawable/bg_dot_inactive" android:layout_marginEnd="6dp"/>
                    <TextView android:id="@+id/tvImportantLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Important" android:textColor="#AAFFEE"
                        android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
                <!-- Hidden RadioGroup for backward compat -->
                <RadioGroup android:id="@+id/rgPriority"
                    android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
                    <RadioButton android:id="@+id/rbNormal"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="true"/>
                    <RadioButton android:id="@+id/rbImportant"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </RadioGroup>
            </LinearLayout>

            <!-- SEND TO -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <View android:layout_width="3dp" android:layout_height="16dp"
                    android:background="@drawable/bg_timetable_left_bar" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SEND TO"
                    android:textSize="11sp" android:textStyle="bold"
                    android:textColor="@color/primary_color" android:letterSpacing="0.08"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_section_card"
                android:layout_marginBottom="14dp" android:elevation="1dp">

                <!-- All Students toggle -->
                <LinearLayout android:id="@+id/rowAllStudents"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:clickable="true" android:focusable="true">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_stat_circle_teal">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:layout_gravity="center" android:src="@drawable/ic_students"
                            android:contentDescription="All" app:tint="#FFFFFF"/>
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="All Students"
                        android:textSize="14sp" android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"/>
                    <CheckBox android:id="@+id/cbAllStudents"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:buttonTint="@color/primary_color"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="58dp" android:background="?attr/colorControlHighlight"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Or select specific courses:"
                    android:textSize="11sp" android:textColor="?attr/colorControlNormal"
                    android:layout_marginStart="14dp" android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"/>

                <!-- Course checkboxes added dynamically -->
                <LinearLayout android:id="@+id/llCourseCheckboxes"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:paddingBottom="8dp"/>
            </LinearLayout>

            <!-- ATTACH PDF -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <View android:layout_width="3dp" android:layout_height="16dp"
                    android:background="@drawable/bg_timetable_left_bar" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ATTACH PDF (Optional)"
                    android:textSize="11sp" android:textStyle="bold"
                    android:textColor="@color/primary_color" android:letterSpacing="0.08"/>
            </LinearLayout>

            <!-- PDF Preview Card — IMPORTANT 1: shown after PDF selected -->
            <LinearLayout android:id="@+id/cardPdfPreview"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_section_card"
                android:layout_marginBottom="10dp" android:elevation="1dp"
                android:visibility="gone">

                <!-- PDF visual preview area (dark teal bg with big icon) -->
                <FrameLayout android:layout_width="match_parent" android:layout_height="160dp"
                    android:background="@color/primary_color">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="center" android:orientation="vertical"
                        android:gravity="center">
                        <ImageView android:id="@+id/ivPdfIcon"
                            android:layout_width="64dp" android:layout_height="64dp"
                            android:src="@drawable/ic_pdf" android:contentDescription="PDF"
                            app:tint="#AAFFEE"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="PDF Document"
                            android:textColor="#AAFFEE" android:textSize="13sp"
                            android:layout_marginTop="10dp"/>
                    </LinearLayout>
                </FrameLayout>

                <!-- PDF info row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="6dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tvPdfName"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="document.pdf"
                            android:textSize="13sp" android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:maxLines="1" android:ellipsize="middle"/>
                        <TextView android:id="@+id/tvPdfSize"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0 KB" android:textSize="11sp"
                            android:textColor="?attr/colorControlNormal" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <ImageView android:id="@+id/btnRemovePdf"
                        android:layout_width="40dp" android:layout_height="40dp"
                        android:src="@drawable/ic_delete" android:padding="10dp"
                        android:contentDescription="Remove PDF"
                        android:clickable="true" android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#C62828"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Attach button (shown when no PDF) -->
            <LinearLayout android:id="@+id/btnAttachPdf"
                android:layout_width="match_parent" android:layout_height="50dp"
                android:orientation="horizontal" android:gravity="center"
                android:background="@drawable/bg_count_badge"
                android:layout_marginBottom="20dp"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_pdf" android:contentDescription="PDF"
                    android:layout_marginEnd="8dp" app:tint="@color/primary_color"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Select PDF File"
                    android:textColor="@color/primary_color"
                    android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- SEND BUTTON -->
            <LinearLayout android:id="@+id/btnSend"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:gravity="center"
                android:background="@drawable/bg_upload_btn"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_send_notif" android:contentDescription="Send"
                    android:layout_marginEnd="8dp" app:tint="#FFFFFF"/>
                <TextView android:id="@+id/tvSendLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Send Announcement"
                    android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
