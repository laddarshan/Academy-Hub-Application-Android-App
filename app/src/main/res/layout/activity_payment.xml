<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/primary_color"
        android:paddingStart="4dp" android:paddingEnd="16dp"
        android:paddingTop="32dp" android:paddingBottom="12dp"
        android:elevation="6dp">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_back" android:padding="12dp"
            android:contentDescription="Back"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"/>
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="4dp">
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Payment"
                android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvStudentBadge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=""
                android:textColor="#AAFFEE" android:textSize="11sp"
                android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary_color"
        android:visibility="gone"/>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="20dp" android:paddingBottom="32dp">

            <!-- Online payment info banner -->
            <LinearLayout
                android:id="@+id/layoutOnlineInfo"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="top"
                android:background="@drawable/bg_count_badge"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_shield"
                    android:contentDescription="Info"
                    android:layout_marginEnd="10dp"
                    app:tint="@color/primary_color"/>
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Online payment is not active. This is a demo view only. Please use Cash mode to collect payment."
                    android:textSize="12sp" android:textColor="@color/primary_color"/>
            </LinearLayout>

            <!-- QR Code panel -->
            <LinearLayout
                android:id="@+id/layoutQr"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_section_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Scan to Pay"
                    android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/primary_color"
                    android:layout_marginBottom="16dp"/>
                <ImageView
                    android:id="@+id/ivQrCode"
                    android:layout_width="200dp" android:layout_height="200dp"
                    android:src="@drawable/ic_qr_placeholder"
                    android:contentDescription="QR Code"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="QR code for payment"
                    android:textSize="12sp" android:textColor="?attr/colorControlNormal"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>

            <!-- UPI panel -->
            <LinearLayout
                android:id="@+id/layoutUpi"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_section_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="UPI Payment"
                    android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/primary_color"
                    android:layout_marginBottom="12dp"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Use any UPI app (GPay, PhonePe, Paytm) to pay to the college UPI ID."
                    android:textSize="13sp" android:textColor="?attr/colorControlNormal"/>
                <TextView
                    android:id="@+id/tvUpiId"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/primary_color"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <!-- Card panel -->
            <LinearLayout
                android:id="@+id/layoutCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_section_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Debit / ATM Card"
                    android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/primary_color"
                    android:layout_marginBottom="12dp"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Card payments are accepted at the college office. Please visit the fees counter with your ATM card."
                    android:textSize="13sp" android:textColor="?attr/colorControlNormal"/>
            </LinearLayout>

            <!-- Net Banking panel -->
            <LinearLayout
                android:id="@+id/layoutNetBanking"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_section_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Net Banking"
                    android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/primary_color"
                    android:layout_marginBottom="12dp"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Transfer fees directly to college bank account."
                    android:textSize="13sp" android:textColor="?attr/colorControlNormal"/>
                <TextView
                    android:id="@+id/tvBankDetails"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp" android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>

            <!-- Cash payment form (always visible for cash mode) -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <View android:layout_width="3dp" android:layout_height="16dp"
                    android:background="@drawable/bg_timetable_left_bar"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:id="@+id/tvFormLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Record Payment"
                    android:textSize="13sp" android:textStyle="bold"
                    android:textColor="@color/primary_color"/>
            </LinearLayout>

            <!-- Pending amount info -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_count_badge"
                android:padding="12dp" android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pending Amount:"
                    android:textSize="13sp" android:textColor="?attr/colorControlNormal"/>
                <TextView
                    android:id="@+id/tvPendingAmount"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textSize="15sp" android:textStyle="bold"
                    android:textColor="#C62828"/>
            </LinearLayout>

            <!-- Input form card -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_section_card"
                android:layout_marginBottom="16dp" android:elevation="1dp">

                <!-- Amount -->
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:layout_gravity="center" android:src="@drawable/ic_fees"
                            android:contentDescription="Amount" app:tint="#FFFFFF"/>
                    </FrameLayout>
                    <EditText
                        android:id="@+id/etAmount"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Payment Amount (₹) *"
                        android:textSize="14sp" android:textColor="?attr/colorOnSurface"
                        android:inputType="numberDecimal" android:maxLines="1"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="60dp"
                    android:background="?attr/colorControlHighlight"/>

                <!-- Payment Date -->
                <LinearLayout
                    android:id="@+id/rowPaymentDate"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:layout_gravity="center" android:src="@drawable/ic_calendar"
                            android:contentDescription="Date" app:tint="#FFFFFF"/>
                    </FrameLayout>
                    <TextView
                        android:id="@+id/tvPaymentDate"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="Select Payment Date *"
                        android:textSize="14sp" android:textColor="?attr/colorControlNormal"/>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_arrow_right" android:rotation="90"
                        android:contentDescription="Pick" app:tint="@color/primary_color"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="60dp"
                    android:background="?attr/colorControlHighlight"/>

                <!-- Payment Mode (read-only from selection) -->
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:layout_gravity="center" android:src="@drawable/ic_mobile"
                            android:contentDescription="Mode" app:tint="#FFFFFF"/>
                    </FrameLayout>
                    <TextView
                        android:id="@+id/tvPaymentMode"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="Cash"
                        android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/primary_color"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="60dp"
                    android:background="?attr/colorControlHighlight"/>

                <!-- Notes -->
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="top"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp">
                    <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:layout_gravity="center" android:src="@drawable/ic_announcement"
                            android:contentDescription="Notes" app:tint="#FFFFFF"/>
                    </FrameLayout>
                    <EditText
                        android:id="@+id/etNotes"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Notes (optional)"
                        android:textSize="14sp" android:textColor="?attr/colorOnSurface"
                        android:inputType="textMultiLine"
                        android:minLines="2" android:maxLines="4"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Save button -->
            <LinearLayout
                android:id="@+id/btnRecordPayment"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:gravity="center"
                android:background="@drawable/bg_upload_btn"
                android:clickable="true" android:focusable="true">
                <ImageView
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_fees" android:contentDescription="Save"
                    android:layout_marginEnd="10dp" app:tint="#FFFFFF"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Record Payment"
                    android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
