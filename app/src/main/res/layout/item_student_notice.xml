<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="?attr/colorSurface"
    android:clickable="true" android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top accent strip -->
        <View
            android:id="@+id/viewAccentStrip"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@drawable/bg_teal_gradient_h"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp">

            <!-- Icon box -->
            <FrameLayout
                android:id="@+id/layoutIconBox"
                android:layout_width="44dp" android:layout_height="44dp"
                android:background="@drawable/bg_menu_icon_green"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:id="@+id/ivTypeIcon"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bell"
                    app:tint="#059669"/>
            </FrameLayout>

            <!-- Content -->
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Title row + unread dot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?attr/colorText1"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-black"
                        android:maxLines="2"
                        android:ellipsize="end"/>

                    <!-- Unread dot -->
                    <View
                        android:id="@+id/viewUnreadDot"
                        android:layout_width="8dp" android:layout_height="8dp"
                        android:background="@drawable/bg_notif_dot"
                        android:layout_marginStart="8dp"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- Message -->
                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorText2"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp"/>

                <!-- Date + Important badge row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:layout_width="11dp" android:layout_height="11dp"
                        android:src="@drawable/ic_clock"
                        app:tint="?attr/colorTextMuted"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?attr/colorTextMuted"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"/>

                    <!-- Important badge -->
                    <TextView
                        android:id="@+id/tvPriority"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⚡ Important"
                        android:textColor="#D97706"
                        android:textSize="9sp"
                        android:fontFamily="sans-serif-black"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="3dp" android:paddingBottom="3dp"
                        android:background="@drawable/bg_upcoming_amber"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- PDF button — shown if hasPdf -->
                <LinearLayout
                    android:id="@+id/btnViewPdf"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_active"
                    android:layout_marginTop="10dp"
                    android:clickable="true" android:focusable="true"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="14dp" android:layout_height="14dp"
                        android:src="@drawable/ic_file_text"
                        app:tint="#FFFFFF"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PDF Juo"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-black"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>