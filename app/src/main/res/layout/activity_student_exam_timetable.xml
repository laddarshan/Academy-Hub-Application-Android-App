<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ══ HEADER ══ -->
            <FrameLayout
                android:id="@+id/layoutHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard_header"
                android:paddingBottom="56dp">

                <View android:layout_width="180dp" android:layout_height="180dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-40dp" android:layout_marginEnd="-30dp"
                    android:background="@drawable/bg_header_orb" android:alpha="0.15"/>

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="52dp"
                    android:paddingStart="20dp" android:paddingEnd="20dp">

                    <!-- Top bar -->
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="22dp">

                        <FrameLayout android:id="@+id/btnBack"
                            android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_header_btn"
                            android:clickable="true" android:focusable="true">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_arrow_left" app:tint="#FFFFFF"/>
                        </FrameLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Exam Timetable"
                                android:textColor="#FFFFFF" android:textSize="20sp"
                                android:fontFamily="sans-serif-black"/>
                            <TextView android:id="@+id/tvHeaderBadge"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="#AAFFFFFF" android:textSize="11sp"
                                android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <FrameLayout android:id="@+id/btnRefresh"
                            android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_header_btn"
                            android:clickable="true" android:focusable="true">
                            <ImageView android:id="@+id/ivRefresh"
                                android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_refresh" app:tint="#FFFFFF"/>
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Tab toggle: Internal / External -->
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_tab_container"
                        android:padding="4dp">

                        <TextView android:id="@+id/tabInternal"
                            android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Internal"
                            android:gravity="center"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-black"
                            android:textColor="#075E54"
                            android:background="@drawable/bg_tab_selected"
                            android:clickable="true" android:focusable="true"/>

                        <TextView android:id="@+id/tabExternal"
                            android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="External"
                            android:gravity="center"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#075E54"
                            android:background="@android:color/transparent"
                            android:clickable="true" android:focusable="true"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ══ BODY ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_body_rounded"
                android:layout_marginTop="-28dp"
                android:paddingTop="24dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="40dp">

                <!-- Loading -->
                <ProgressBar android:id="@+id/progressBar"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="60dp" android:layout_marginBottom="60dp"
                    android:visibility="gone"/>

                <!-- Internal card -->
                <LinearLayout android:id="@+id/layoutInternal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- Empty state -->
                    <LinearLayout android:id="@+id/layoutInternalEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="60dp" android:paddingBottom="40dp"
                        android:visibility="gone">
                        <ImageView android:layout_width="72dp" android:layout_height="72dp"
                            android:src="@drawable/ic_file_text" app:tint="?attr/colorTextMuted"
                            android:alpha="0.3"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="No Internal Timetable"
                            android:textColor="?attr/colorTextMuted" android:textSize="15sp"
                            android:fontFamily="sans-serif-black" android:layout_marginTop="14dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Admin hashe upload kari deyshe"
                            android:textColor="?attr/colorTextMuted" android:textSize="12sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- File preview card -->
                    <androidx.cardview.widget.CardView android:id="@+id/cardInternalPreview"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        app:cardCornerRadius="20dp" app:cardElevation="4dp"
                        app:cardBackgroundColor="?attr/colorSurface"
                        android:clickable="true" android:focusable="true"
                        android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <!-- Card accent top -->
                            <View android:layout_width="match_parent" android:layout_height="3dp"
                                android:background="@drawable/bg_teal_gradient_h"/>
                            <LinearLayout android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="18dp" android:gravity="center_vertical">
                                <FrameLayout android:layout_width="56dp" android:layout_height="56dp"
                                    android:background="@drawable/bg_menu_icon_green"
                                    android:layout_marginEnd="16dp">
                                    <ImageView android:id="@+id/ivInternalIcon"
                                        android:layout_width="28dp" android:layout_height="28dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_file_text" app:tint="#059669"/>
                                </FrameLayout>
                                <LinearLayout android:layout_width="0dp"
                                    android:layout_height="wrap_content" android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Internal Exam"
                                        android:textColor="?attr/colorTextMuted" android:textSize="11sp"
                                        android:fontFamily="sans-serif-medium"
                                        android:textAllCaps="true" android:letterSpacing="0.05"/>
                                    <TextView android:id="@+id/tvInternalFileName"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Timetable"
                                        android:textColor="?attr/colorText1" android:textSize="15sp"
                                        android:fontFamily="sans-serif-black"
                                        android:layout_marginTop="2dp"
                                        android:maxLines="1" android:ellipsize="end"/>
                                    <TextView android:id="@+id/tvInternalFileType"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:background="@drawable/bg_chip_active"
                                        android:paddingStart="10dp" android:paddingEnd="10dp"
                                        android:paddingTop="3dp" android:paddingBottom="3dp"
                                        android:textColor="#FFFFFF" android:textSize="10sp"
                                        android:fontFamily="sans-serif-medium"/>
                                </LinearLayout>
                                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                                    android:src="@drawable/ic_eye" app:tint="?attr/colorTeal2"
                                    android:layout_marginStart="8dp"/>
                            </LinearLayout>
                            <!-- Thumbnail -->
                            <ImageView android:id="@+id/ivInternalThumbnail"
                                android:layout_width="match_parent" android:layout_height="180dp"
                                android:scaleType="centerCrop"
                                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                                android:layout_marginBottom="16dp"
                                android:background="@drawable/bg_attend_pill"
                                android:visibility="gone"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- External card — same structure -->
                <LinearLayout android:id="@+id/layoutExternal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout android:id="@+id/layoutExternalEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="60dp" android:paddingBottom="40dp"
                        android:visibility="gone">
                        <ImageView android:layout_width="72dp" android:layout_height="72dp"
                            android:src="@drawable/ic_file_text" app:tint="?attr/colorTextMuted"
                            android:alpha="0.3"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="No External Timetable"
                            android:textColor="?attr/colorTextMuted" android:textSize="15sp"
                            android:fontFamily="sans-serif-black" android:layout_marginTop="14dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Admin hashe upload kari deyshe"
                            android:textColor="?attr/colorTextMuted" android:textSize="12sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <androidx.cardview.widget.CardView android:id="@+id/cardExternalPreview"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        app:cardCornerRadius="20dp" app:cardElevation="4dp"
                        app:cardBackgroundColor="?attr/colorSurface"
                        android:clickable="true" android:focusable="true"
                        android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <View android:layout_width="match_parent" android:layout_height="3dp"
                                android:background="@drawable/bg_upcoming_sky"/>
                            <LinearLayout android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="18dp" android:gravity="center_vertical">
                                <FrameLayout android:layout_width="56dp" android:layout_height="56dp"
                                    android:background="@drawable/bg_menu_icon_sky"
                                    android:layout_marginEnd="16dp">
                                    <ImageView android:id="@+id/ivExternalIcon"
                                        android:layout_width="28dp" android:layout_height="28dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_file_text" app:tint="#0284C7"/>
                                </FrameLayout>
                                <LinearLayout android:layout_width="0dp"
                                    android:layout_height="wrap_content" android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="External Exam"
                                        android:textColor="?attr/colorTextMuted" android:textSize="11sp"
                                        android:fontFamily="sans-serif-medium"
                                        android:textAllCaps="true" android:letterSpacing="0.05"/>
                                    <TextView android:id="@+id/tvExternalFileName"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Timetable"
                                        android:textColor="?attr/colorText1" android:textSize="15sp"
                                        android:fontFamily="sans-serif-black"
                                        android:layout_marginTop="2dp"
                                        android:maxLines="1" android:ellipsize="end"/>
                                    <TextView android:id="@+id/tvExternalFileType"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:background="@drawable/bg_menu_icon_sky"
                                        android:paddingStart="10dp" android:paddingEnd="10dp"
                                        android:paddingTop="3dp" android:paddingBottom="3dp"
                                        android:textColor="#0284C7" android:textSize="10sp"
                                        android:fontFamily="sans-serif-medium"/>
                                </LinearLayout>
                                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                                    android:src="@drawable/ic_eye" app:tint="?attr/colorTeal2"
                                    android:layout_marginStart="8dp"/>
                            </LinearLayout>
                            <ImageView android:id="@+id/ivExternalThumbnail"
                                android:layout_width="match_parent" android:layout_height="180dp"
                                android:scaleType="centerCrop"
                                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                                android:layout_marginBottom="16dp"
                                android:background="@drawable/bg_attend_pill"
                                android:visibility="gone"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
