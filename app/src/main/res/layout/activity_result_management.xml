<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- ══ HEADER ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#075E54"
        android:paddingStart="4dp" android:paddingEnd="16dp"
        android:paddingTop="32dp" android:paddingBottom="16dp"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/ic_back"
                android:padding="12dp"
                android:contentDescription="Back"
                android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF"/>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Result Management"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvGroupBadge"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#AAFFEE"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Top thin progress -->
    <ProgressBar
        android:id="@+id/progressBarTop"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:indeterminate="true"
        android:indeterminateTint="#075E54"
        android:visibility="gone"/>

    <!-- ══ SWIPE REFRESH + CONTENT ══ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/layoutContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingTop="20dp" android:paddingBottom="32dp"
                android:alpha="0">

                <!-- ════ INTERNAL RESULT CARD ════ -->
                <LinearLayout
                    android:id="@+id/cardInternal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_section_card"
                    android:layout_marginBottom="16dp"
                    android:elevation="2dp">

                    <!-- Card Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:paddingTop="16dp" android:paddingBottom="12dp">

                        <FrameLayout
                            android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_status_active">
                            <ImageView
                                android:layout_width="22dp" android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_internal_result"
                                android:contentDescription="Internal Result"/>
                        </FrameLayout>

                        <LinearLayout

                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvInternalTitle"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Internal Result"
                                android:textSize="16sp" android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"/>

                            <TextView
                                android:id="@+id/tvInternalSubtitle"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="College sheet PDF upload karo"
                                android:textSize="12sp"
                                android:textColor="?attr/colorControlNormal"/>
                        </LinearLayout>

                        <!-- Upload Button -->
                        <LinearLayout
                            android:id="@+id/btnUploadInternal"
                            android:layout_width="wrap_content" android:layout_height="36dp"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/bg_upload_btn"
                            android:paddingStart="14dp" android:paddingEnd="14dp"
                            android:clickable="true" android:focusable="true">
                            <ImageView
                                android:layout_width="16dp" android:layout_height="16dp"
                                android:src="@drawable/ic_upload"
                                android:contentDescription="Upload"
                                android:layout_marginEnd="6dp"/>
                            <TextView
                                android:id="@+id/tvUploadInternalLabel"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Upload"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="70dp"
                        android:background="?attr/colorControlHighlight"/>

                    <!-- Upload Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progressBarInternal"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="15dp"
                        android:indeterminate="true"
                        android:indeterminateTint="#075E54"
                        android:visibility="gone"
                        android:layout_marginTop="2dp"/>

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/layoutInternalEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_empty_state"
                        android:layout_margin="16dp">

                        <ImageView
                            android:layout_width="28dp" android:layout_height="28dp"
                            android:src="@drawable/ic_internal_result"
                            android:contentDescription="No result"
                            android:alpha="0.35"/>
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="No result uploaded yet"
                            android:textSize="13sp"
                            android:textColor="?attr/colorControlNormal"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>

                    <!-- Preview Row (after upload) -->
                    <LinearLayout
                        android:id="@+id/layoutInternalUploaded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_preview_card"
                        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp" android:paddingEnd="14dp">

                            <ImageView
                                android:layout_width="22dp" android:layout_height="22dp"
                                android:src="@drawable/ic_pdf"
                                android:contentDescription="PDF"/>

                            <LinearLayout
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="10dp">

                                <TextView
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="PDF Uploaded"
                                    android:textSize="13sp" android:textStyle="bold"
                                    android:textColor="#075E54"/>

                                <TextView
                                    android:id="@+id/tvInternalFileName"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="result.pdf"
                                    android:textSize="11sp"
                                    android:textColor="?attr/colorControlNormal"
                                    android:ellipsize="end" android:maxLines="1"/>
                            </LinearLayout>

                            <!-- View PDF inline button -->
                            <LinearLayout
                                android:id="@+id/btnViewInternal"
                                android:layout_width="wrap_content" android:layout_height="32dp"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:background="@drawable/bg_status_active"
                                android:paddingStart="10dp" android:paddingEnd="10dp"
                                android:clickable="true" android:focusable="true">
                                <ImageView
                                    android:layout_width="14dp" android:layout_height="14dp"
                                    android:src="@drawable/ic_view_pdf"
                                    android:contentDescription="View"
                                    android:layout_marginEnd="4dp"/>
                                <TextView
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="View"
                                    android:textSize="12sp" android:textStyle="bold"
                                    android:textColor="#075E54"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Delete row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp" android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/btnDeleteInternal"
                            android:layout_width="wrap_content" android:layout_height="32dp"
                            android:text="Delete File"
                            android:textSize="12sp" android:textStyle="bold"
                            android:textColor="#C62828"
                            android:gravity="center"
                            android:paddingStart="14dp" android:paddingEnd="14dp"
                            android:background="@drawable/bg_status_blocked"
                            android:clickable="true" android:focusable="true"
                            android:visibility="gone"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- ════ EXTERNAL RESULT CARD ════ -->
                <LinearLayout
                    android:id="@+id/cardExternal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_section_card"
                    android:layout_marginBottom="16dp"
                    android:elevation="2dp">

                    <!-- Card Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:paddingTop="16dp" android:paddingBottom="12dp">

                        <FrameLayout
                            android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_status_pending">
                            <ImageView

                                android:layout_width="22dp" android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_external_result"
                                android:contentDescription="External Result"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvExternalTitle"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="External Result"
                                android:textSize="16sp" android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"/>

                            <TextView
                                android:id="@+id/tvExternalSubtitle"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Students ne FCM notification moklo"
                                android:textSize="12sp"
                                android:textColor="?attr/colorControlNormal"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="70dp"
                        android:background="?attr/colorControlHighlight"/>

                    <!-- Notification Preview Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_notification_preview"
                        android:layout_margin="16dp"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_notifications"
                                android:contentDescription="Notification"
                                app:tint="#075E54"
                                android:layout_marginEnd="6dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Notification Preview"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#075E54"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="External Result Available"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorControlNormal"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your external result is now available. Please check online."
                            android:textSize="12sp"
                            android:textColor="?attr/colorControlNormal"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- Status Badge Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginBottom="12dp">

                        <FrameLayout
                            android:id="@+id/layoutExternalStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_not_sent_badge"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">

                            <TextView
                                android:id="@+id/tvExternalStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Not sent yet"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#E65100"/>
                        </FrameLayout>
                    </LinearLayout>

                    <!-- External Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progressBarExternal"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="15dp"
                        android:indeterminate="true"
                        android:indeterminateTint="#075E54"
                        android:visibility="gone"
                        android:layout_marginBottom="4dp"/>

                    <!-- Send Button -->
                    <LinearLayout
                        android:id="@+id/btnSendExternal"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_upload_btn"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_send_notif"
                            android:contentDescription="Send"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/tvSendExternalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Send Notification to Students"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Cancel Button -->
                    <LinearLayout
                        android:id="@+id/btnCancelExternal"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_status_blocked"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@drawable/ic_cancel_notif"
                            android:contentDescription="Cancel"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Cancel Notification"
                            android:textColor="#C62828"
                            android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="16dp"/>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
