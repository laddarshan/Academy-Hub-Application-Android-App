<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?android:attr/colorBackground">

    <!-- HEADER -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#075E54" android:paddingStart="4dp" android:paddingEnd="16dp"
        android:paddingTop="32dp" android:paddingBottom="12dp" android:elevation="6dp">
        <ImageView android:id="@+id/btnBack"
            android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_back" android:padding="12dp"
            android:contentDescription="Back" android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" app:tint="#FFFFFF"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
            <TextView android:id="@+id/tvTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Add Timetable Entry"
                android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Fill in class details"
                android:textColor="#AAFFEE" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp"
        android:indeterminate="true" android:indeterminateTint="#075E54" android:visibility="gone"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="20dp" android:paddingBottom="32dp">

            <!-- ══ CLASS INFO ══ -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <View android:layout_width="3dp" android:layout_height="16dp"
                    android:background="@drawable/bg_timetable_left_bar" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Class Information"
                    android:textSize="13sp" android:textStyle="bold" android:textColor="#075E54"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_section_card"
                android:layout_marginBottom="16dp" android:elevation="1dp">

                <!-- Course -->
                <LinearLayout android:id="@+id/spinnerCourse"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp"
                            android:layout_gravity="center" android:src="@drawable/ic_courses"
                            android:contentDescription="Course"/>
                    </FrameLayout>
                    <TextView android:id="@+id/tvCourseLabel"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="Select Course"
                        android:textSize="14sp" android:textColor="#888888" android:maxLines="1" android:ellipsize="end"/>
                    <ImageView android:layout_width="14dp" android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right" android:contentDescription="Select" app:tint="#075E54"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="58dp" android:background="?attr/colorControlHighlight"/>

                <!-- Semester -->
                <LinearLayout android:id="@+id/spinnerSemester"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp"
                            android:layout_gravity="center" android:src="@drawable/ic_academic"
                            android:contentDescription="Semester"/>
                    </FrameLayout>
                    <TextView android:id="@+id/tvSemesterLabel"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="Select Semester"
                        android:textSize="14sp" android:textColor="#888888" android:maxLines="1" android:ellipsize="end"/>
                    <ImageView android:layout_width="14dp" android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right" android:contentDescription="Select" app:tint="#075E54"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="58dp" android:background="?attr/colorControlHighlight"/>

                <!-- Batch -->
                <LinearLayout android:id="@+id/spinnerBatch"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp"
                            android:layout_gravity="center" android:src="@drawable/ic_batch"
                            android:contentDescription="Batch"/>
                    </FrameLayout>
                    <TextView android:id="@+id/tvBatchLabel"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="Select Batch"
                        android:textSize="14sp" android:textColor="#888888" android:maxLines="1" android:ellipsize="end"/>
                    <ImageView android:layout_width="14dp" android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right" android:contentDescription="Select" app:tint="#075E54"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="58dp" android:background="?attr/colorControlHighlight"/>

                <!-- Subject from Firestore -->
                <LinearLayout
                    android:id="@+id/spinnerSubject"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp"
                            android:layout_gravity="center" android:src="@drawable/ic_subject"
                            android:contentDescription="Subject"/>
                    </FrameLayout>
                    <TextView
                        android:id="@+id/tvSubjectLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Select Subject"
                        android:textSize="14sp"
                        android:textColor="#888888"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <ImageView android:layout_width="14dp" android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right" android:contentDescription="Select" app:tint="#075E54"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="58dp" android:background="?attr/colorControlHighlight"/>

                <!-- Subject name (editable, auto-filled from picker) -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp"
                            android:layout_gravity="center" android:src="@drawable/ic_edit"
                            android:contentDescription="Name"/>
                    </FrameLayout>
                    <EditText android:id="@+id/etSubject"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Subject name *"
                        android:textSize="14sp" android:textColor="?attr/colorOnSurface"
                        android:inputType="textCapWords" android:maxLines="1"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="58dp" android:background="?attr/colorControlHighlight"/>

                <!-- Teacher -->
                <LinearLayout
                    android:id="@+id/spinnerTeacher"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp"
                            android:layout_gravity="center" android:src="@drawable/ic_teacher"
                            android:contentDescription="Teacher"/>
                    </FrameLayout>
                    <TextView android:id="@+id/tvTeacherLabel"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="Select Teacher"
                        android:textSize="14sp" android:textColor="#888888" android:maxLines="1" android:ellipsize="end"/>
                    <ImageView android:layout_width="14dp" android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right" android:contentDescription="Select" app:tint="#075E54"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ══ SCHEDULE ══ -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <View android:layout_width="3dp" android:layout_height="16dp"
                    android:background="@drawable/bg_timetable_left_bar" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Schedule"
                    android:textSize="13sp" android:textStyle="bold" android:textColor="#075E54"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_section_card"
                android:layout_marginBottom="16dp" android:elevation="1dp">

                <!-- Day -->
                <LinearLayout android:id="@+id/spinnerDay"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp"
                            android:layout_gravity="center" android:src="@drawable/ic_day"
                            android:contentDescription="Day"/>
                    </FrameLayout>
                    <TextView android:id="@+id/tvDayLabel"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="Select Day"
                        android:textSize="14sp" android:textColor="#888888"/>
                    <ImageView android:layout_width="14dp" android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right" android:contentDescription="Select" app:tint="#075E54"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="58dp" android:background="?attr/colorControlHighlight"/>

                <!-- Time row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp"
                            android:layout_gravity="center" android:src="@drawable/ic_time"
                            android:contentDescription="Time"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:orientation="horizontal">
                        <LinearLayout android:id="@+id/etStartTime"
                            android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:gravity="center"
                            android:background="@drawable/bg_input_field"
                            android:paddingStart="10dp" android:paddingEnd="10dp"
                            android:clickable="true" android:focusable="true"
                            android:layout_marginEnd="8dp">
                            <TextView android:id="@+id/tvStartTimeVal"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Start Time"
                                android:textSize="12sp" android:textColor="#888888"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/etEndTime"
                            android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:gravity="center"
                            android:background="@drawable/bg_input_field"
                            android:paddingStart="10dp" android:paddingEnd="10dp"
                            android:clickable="true" android:focusable="true">
                            <TextView android:id="@+id/tvEndTimeVal"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="End Time"
                                android:textSize="12sp" android:textColor="#888888"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ══ LOCATION & TYPE ══ -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <View android:layout_width="3dp" android:layout_height="16dp"
                    android:background="@drawable/bg_timetable_left_bar" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Location and Type"
                    android:textSize="13sp" android:textStyle="bold" android:textColor="#075E54"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_section_card"
                android:layout_marginBottom="16dp" android:elevation="1dp">

                <!-- Classroom -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp"
                            android:layout_gravity="center" android:src="@drawable/ic_classroom"
                            android:contentDescription="Room"/>
                    </FrameLayout>
                    <EditText android:id="@+id/etClassroom"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Classroom / Room Number"
                        android:textSize="14sp" android:textColor="?attr/colorOnSurface"
                        android:inputType="text" android:maxLines="1"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="58dp" android:background="?attr/colorControlHighlight"/>

                <!-- Type -->
                <LinearLayout android:id="@+id/spinnerType"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp"
                            android:layout_gravity="center" android:src="@drawable/ic_timetable"
                            android:contentDescription="Type"/>
                    </FrameLayout>
                    <TextView android:id="@+id/tvTypeLabel"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="Select Class Type"
                        android:textSize="14sp" android:textColor="#888888"/>
                    <ImageView android:layout_width="14dp" android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right" android:contentDescription="Select" app:tint="#075E54"/>
                </LinearLayout>

                <!-- Online link (conditional) -->
                <LinearLayout android:id="@+id/layoutOnlineLink"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:visibility="gone">
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="?attr/colorControlHighlight"/>
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp"
                            android:layout_gravity="center" android:src="@drawable/ic_online_link"
                            android:contentDescription="Link"/>
                    </FrameLayout>
                    <EditText android:id="@+id/etOnlineLink"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Online Meeting Link"
                        android:textSize="14sp" android:inputType="textUri" android:maxLines="1"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Notes -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_section_card"
                android:layout_marginBottom="24dp" android:elevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="top"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:paddingTop="12dp" android:paddingBottom="12dp">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_status_active">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp"
                            android:layout_gravity="center" android:src="@drawable/ic_announcement"
                            android:contentDescription="Notes"/>
                    </FrameLayout>
                    <EditText android:id="@+id/etNotes"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Notes (Optional)"
                        android:textSize="14sp" android:inputType="textMultiLine"
                        android:minLines="2" android:maxLines="4"/>
                </LinearLayout>
            </LinearLayout>

            <!-- SAVE BUTTON -->
            <LinearLayout android:id="@+id/btnSave"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:gravity="center"
                android:background="@drawable/bg_upload_btn"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_timetable" android:contentDescription="Save"
                    android:layout_marginEnd="10dp" app:tint="#FFFFFF"/>
                <TextView android:id="@+id/tvSaveLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Save Timetable Entry"
                    android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
